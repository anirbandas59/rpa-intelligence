# Environment Configuration
# Copy this file to .env and configure for your environment

# ===== DEPLOYMENT MODE =====
# Options: development | production
# In development mode with no SECRET_KEY, auth is bypassed (dev user auto-created)
ENVIRONMENT=development

# ===== AUTHENTICATION =====
# JWT Secret Key (leave empty for dev mode auth bypass)
# In production, set to a secure random string (min 32 characters)
SECRET_KEY=

# Access token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== DATABASE =====
# SQLite (local development)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ===== LLM CONFIGURATION =====
# Anthropic API Key
ANTHROPIC_API_KEY=your_key_here

# Default provider and model
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-4-5

# ===== FEATURE FLAGS =====
# Use LangGraph complexity agent (default: false)
USE_LANGGRAPH_COMPLEXITY_AGENT=false

# ===== OPTIONAL =====
# Redis URL (for session storage)
# REDIS_URL=redis://localhost:6379/0

# Frontend URL (for CORS)
# FRONTEND_URL=http://localhost:3000

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO