# ══════════════════════════════════════════════════════════════════
# RPA Intelligence Platform — Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and configure for your environment

# ── Deployment Environment ─────────────────────────────────────────
# Options: development | production
# In development mode with empty SECRET_KEY, JWT auth is bypassed
ENVIRONMENT=development

# ── Database Configuration ─────────────────────────────────────────
# SQLite (local development)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# PostgreSQL (production — uncomment and configure)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rpa_intelligence

# ── Authentication & Security ──────────────────────────────────────
# JWT Secret Key for token signing
# IMPORTANT: Leave empty for dev mode auth bypass (auto-creates dev@localhost user)
# In production, set to a secure random string (min 32 characters)
SECRET_KEY=

# JWT token expiration time in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Key for X-API-Key header authentication (optional, leave empty to disable)
# Used by api/middleware/auth.py for additional auth layer
API_SECRET_KEY=

# ── LLM Provider Configuration ─────────────────────────────────────
# Options: anthropic | openai | watsonx | ollama
DEFAULT_LLM_PROVIDER=anthropic

# Model name for the chosen provider:
# - anthropic: claude-sonnet-4-6, claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-8
# - openai:    gpt-4o, gpt-4-turbo
# - watsonx:   ibm/granite-13b-chat-v2
# - ollama:    llama3, mistral
DEFAULT_LLM_MODEL=claude-sonnet-4-5

# ── Provider API Keys ──────────────────────────────────────────────
# Anthropic API Key (required if DEFAULT_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI API Key (required if DEFAULT_LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ── Watsonx Configuration ──────────────────────────────────────────
# (Required only if DEFAULT_LLM_PROVIDER=watsonx)
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# ── Ollama Configuration ───────────────────────────────────────────
# (Required only if DEFAULT_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM Manager Behavior ───────────────────────────────────────────
# Maximum retry attempts on rate limit errors
LLM_MAX_RETRIES=3

# Base delay in seconds for exponential backoff (delays: 1s, 2s, 4s, ...)
LLM_RETRY_BASE_DELAY=1.0

# ── Session Store (Redis) ──────────────────────────────────────────
# Redis connection URL for LangGraph state persistence and checkpointing
# Leave default for local development, configure for production
REDIS_URL=redis://localhost:6379/0

# ── CORS & Frontend ────────────────────────────────────────────────
# Frontend URL allowed by CORS (default: Next.js dev server)
FRONTEND_URL=http://localhost:3000

# ── Application Paths ──────────────────────────────────────────────
# Output directory for generated Excel/PDF reports
OUTPUT_DIR=data/outputs

# Temporary directory for file uploads and processing
TEMP_DIR=data/temp

# ── Logging ────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: text | json (use json for production log aggregators)
# LOG_FORMAT=text

# ── Feature Flags ──────────────────────────────────────────────────
# Use LangGraph StateGraph agent for Stage 2 complexity assessment
# Options: true | false (default: false for v1 legacy pipeline)
# Set to true to enable v2 LangGraph agent with LLM reasoning
USE_LANGGRAPH_COMPLEXITY_AGENT=false

# ══════════════════════════════════════════════════════════════════
# Quick Start for Development:
# ══════════════════════════════════════════════════════════════════
# 1. Copy this file:        cp .env.example .env
# 2. Set your API key:      ANTHROPIC_API_KEY=sk-ant-...
# 3. Leave SECRET_KEY empty (dev mode auth bypass)
# 4. Run backend:           uv run uvicorn api.main:app --reload
# 5. Run frontend:          cd ../frontend && npm run dev
# 6. Access API:            http://localhost:8000 (no auth needed in dev)
# 7. Access frontend:       http://localhost:3000
# ══════════════════════════════════════════════════════════════════